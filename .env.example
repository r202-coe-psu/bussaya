# Settings for the standalone bussaya-controller command (deadline-reminder
# cron job). Copy this file to .env and fill in real values; .env is
# gitignored so it's safe to put secrets in it.

MONGODB_DB=bussayadb
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USERNAME=
MONGODB_PASSWORD=

MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=
MAIL_SENDER_NAME=Bussaya

SITE_BASE_URL=
