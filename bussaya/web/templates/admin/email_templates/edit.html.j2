{% extends '/admin/email_templates/index.html.j2' %}
{% import '/base/html-renderer.html.j2' as renderer %}

{% block dashboard_title %}
Edit Email Template
{% endblock %}

{% block breadcrumbs %}
  {{ super() }}
  <li>Edit</li>
{% endblock %}

{% block content %}
  <h2 class="text-2xl font-bold">Edit {{ template.get_type_display() }} Email</h2>
  <div class="divider"></div>

  <div class="alert alert-info mb-4">
    <div>
      <div class="font-semibold">Available variables</div>
      <div class="flex flex-wrap gap-1 mt-1">
        {% for variable in template.get_variables() %}
          <code class="badge badge-outline">{{ '{{ ' + variable + ' }}' }}</code>
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="card bg-base-100 shadow my-4">
    <div class="card-body">
    <form method="POST">
      {{ form.csrf_token }}
      {{ renderer.render_field(form.subject) }}
      {{ renderer.render_field(form.body) }}

      <button type="submit" class="btn btn-primary">Save</button>
      <a href="{{ url_for('admin.email_templates.index') }}" class="btn btn-ghost">Cancel</a>
    </form>
    </div>
  </div>

{% endblock %}
