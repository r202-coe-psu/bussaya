{% extends '/base/default-dashboard.html.j2' %}

{% block dashboard_title %}
Organizations
{% endblock %}

{% block breadcrumbs %}
    {{ super() }}
    {% if request.endpoint == 'admin.organizations.index' %}
      <li>Organizations</li>
    {% else %}
      <li><a href="{{ url_for('admin.organizations.index') }}">Organizations</a></li>
    {% endif %}
{% endblock %}

{% block content %}

<h1 class="divider text-2xl font-bold">
	<i class="fa-solid fa-chalkboard fa-sm"></i>
	All Organizations
</h1>

<div class="">
	<form method="GET" class="flex flex-wrap items-center gap-2 mb-4">
		<input type="text" name="q" value="{{ query }}" placeholder="Search by name, website, address, or remark"
		       class="input input-bordered w-full max-w-sm" />
		<button type="submit" class="btn btn-primary gap-1">
			<i class="fa-solid fa-magnifying-glass"></i> Search
		</button>
		{% if query %}
		<a href="{{ url_for('admin.organizations.index') }}" class="btn btn-ghost">Clear</a>
		{% endif %}
	</form>

	{% if organizations %}
	<div class="overflow-x-auto">
	<table class="table table-zebra">
		<thead>
			<tr>
				<th>Name</th>
				<th>Remark</th>
				<th>Operation</th>
			</tr>
		</thead>

		<tbody>
			{% for organization in organizations %}
        <tr>
          <td>
            <a href="{{ url_for('admin.organizations.view', organization_id=organization.id) }}">{{ organization.name }}</a>
          </td>
          <td>
            <div>Website: {{ organization.website }}</div>
            <div>
              {{ organization.remark }}
            </div>
          </td>
          <td>
            <a href="{{ url_for('admin.organizations.view', organization_id=organization.id) }}" class="btn btn-circle btn-primary"><i class="fa-solid fa-eye"></i></a>
            <a href="{{ url_for('admin.organizations.create_or_edit', organization_id=organization.id) }}" class="btn btn-circle btn-primary"><i class="fa-solid fa-pen-to-square"></i></a>
          </td>
  			</tr>
			{% endfor %}
		</tbody>
	</table>
	</div>

	{% if total_pages > 1 %}
	<div class="flex items-center justify-between mt-4">
		<div class="text-sm opacity-70">
			Page {{ page }} of {{ total_pages }} ({{ total }} organization{{ 's' if total != 1 else '' }})
		</div>
		<div class="join">
			<a href="{{ url_for('admin.organizations.index', q=query, page=page - 1) }}"
			   class="join-item btn {{ 'btn-disabled' if page <= 1 else '' }}">&laquo;</a>
			{% for p in range(1, total_pages + 1) %}
			<a href="{{ url_for('admin.organizations.index', q=query, page=p) }}"
			   class="join-item btn {{ 'btn-active' if p == page else '' }}">{{ p }}</a>
			{% endfor %}
			<a href="{{ url_for('admin.organizations.index', q=query, page=page + 1) }}"
			   class="join-item btn {{ 'btn-disabled' if page >= total_pages else '' }}">&raquo;</a>
		</div>
	</div>
	{% endif %}
	{% else %}
	<div class="alert alert-info mb-4">
		{% if query %}No organizations match "{{ query }}".{% else %}No organizations yet.{% endif %}
	</div>
	{% endif %}

	<a class="btn btn-primary" href="{{ url_for('admin.organizations.create_or_edit') }}">
		Create Organization
	</a>
</div>


{% endblock %}
