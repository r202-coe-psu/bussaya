{% extends '/admin/rubrics/index.html.j2' %}
{% import '/base/html-renderer.html.j2' as renderer %}

{% block breadcrumbs %}
  {{ super() }}
  <li>{{ template.name }}</li>
{% endblock %}


{% block content %}

<h2 class="text-2xl font-bold">
  {{ template.name }} <span class="badge">{{ template.get_class_type_display() }}</span>
  <span class="badge {{ 'badge-success' if template.status == 'active' else 'badge-ghost' if template.status == 'archived' else 'badge-warning' }}">
    {{ template.status }} v{{ template.version }}
  </span>
</h2>
<div class="opacity-60">Curriculums: {{ template.curriculums|map(attribute='name')|join(', ') }}</div>
<div class="divider"></div>

<div class="overflow-x-auto">
<table class="table table-zebra">
  <thead>
    <tr>
      <th>#</th>
      <th>Criterion</th>
      <th>Max Score</th>
      <th>CLOs</th>
      {% if template.is_editable() %}<th>Operation</th>{% endif %}
    </tr>
  </thead>
  <tbody>
    {% for criterion in template.get_sorted_criteria() %}
      <tr>
        <td>{{ loop.index }}</td>
        <td>
          <div class="font-semibold">{{ criterion.name }}</div>
          <div class="opacity-60">{{ criterion.description }}</div>
          <div class="collapse collapse-arrow bg-base-200 mt-2">
            <input type="checkbox" />
            <div class="collapse-title text-xs font-medium py-1 min-h-0">
              Grade Level Explanations (A, B+, B, C+, C, D+, D, E, I, W)
            </div>
            <div class="collapse-content text-xs">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-2 pt-2">
                {% for lvl in ["A", "B+", "B", "C+", "C", "D+", "D", "E", "I", "W"] %}
                  <div class="border rounded p-2 bg-base-100">
                    <span class="font-bold text-primary">{{ lvl }}:</span>
                    {{ criterion.get_level_explanation(lvl) or '(No explanation provided)' }}
                  </div>
                {% endfor %}
              </div>
            </div>
          </div>
        </td>
        <td class="font-semibold">{{ criterion.max_score }}</td>
        <td>
          {% for clo in criterion.clos %}
            <span class="badge badge-outline">{{ clo.code }}</span>
          {% endfor %}
        </td>
        {% if template.is_editable() %}
        <td>
          <a href="{{ url_for('admin.rubrics.edit_criterion', template_id=template.id, criterion_id=criterion.id) }}" class="btn btn-circle btn-primary btn-sm"><i class="fa-solid fa-pen-to-square"></i></a>
          <a href="{{ url_for('admin.rubrics.move_criterion', template_id=template.id, criterion_id=criterion.id, direction='up') }}" class="btn btn-circle btn-sm"><i class="fa-solid fa-arrow-up"></i></a>
          <a href="{{ url_for('admin.rubrics.move_criterion', template_id=template.id, criterion_id=criterion.id, direction='down') }}" class="btn btn-circle btn-sm"><i class="fa-solid fa-arrow-down"></i></a>
          <a href="{{ url_for('admin.rubrics.remove_criterion', template_id=template.id, criterion_id=criterion.id) }}" class="btn btn-circle btn-error btn-sm"><i class="fa-solid fa-trash"></i></a>
        </td>
        {% endif %}
      </tr>
    {% endfor %}
    <tr class="font-bold bg-base-200">
      <td colspan="2" class="text-right">Total Max Score:</td>
      <td>
        <span class="badge {{ 'badge-success' if template.get_total_max_score() == 100 else 'badge-warning' }} text-sm font-bold">
          {{ template.get_total_max_score() }} / 100 pts
        </span>
      </td>
      <td colspan="{{ 2 if template.is_editable() else 1 }}"></td>
    </tr>
  </tbody>
</table>
</div>

{% if template.is_editable() %}
<div class="card bg-base-100 shadow my-4">
  <div class="card-body">
    <h3 class="text-xl font-semibold">Add Criterion</h3>
    <form method="POST">
      {{ form.csrf_token }}
      {{ renderer.render_field(form.name) }}
      {{ renderer.render_field(form.description) }}
      {{ renderer.render_field(form.max_score) }}
      {{ renderer.render_field(form.clos) }}

      <div class="divider text-sm font-semibold">Grade Level Explanations (A, B+, B, C+, C, D+, D, E, I, W)</div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {{ renderer.render_field(form.level_A) }}
        {{ renderer.render_field(form.level_B_plus) }}
        {{ renderer.render_field(form.level_B) }}
        {{ renderer.render_field(form.level_C_plus) }}
        {{ renderer.render_field(form.level_C) }}
        {{ renderer.render_field(form.level_D_plus) }}
        {{ renderer.render_field(form.level_D) }}
        {{ renderer.render_field(form.level_E) }}
        {{ renderer.render_field(form.level_I) }}
        {{ renderer.render_field(form.level_W) }}
      </div>

      <button type="submit" class="btn btn-primary mt-4">Add Criterion</button>
    </form>
  </div>
</div>
{% endif %}

{% endblock %}
