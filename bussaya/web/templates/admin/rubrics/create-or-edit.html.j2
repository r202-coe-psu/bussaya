{% extends '/admin/rubrics/index.html.j2' %}
{% import '/base/html-renderer.html.j2' as renderer %}

{% block dashboard_title %}
	{% if template %}
		Edit
	{% else %}
		Create
	{% endif %}
	Rubric Template
{% endblock %}

{% block breadcrumbs %}
  {{ super() }}
	<li>
    {% if template %}
      Edit
    {% else %}
      Create
    {% endif %}
    Rubric Template
  </li>
{% endblock %}


{% block content %}
  <h2 class="text-2xl font-bold">
    {% if template %}
      Edit Rubric Template
    {% else %}
      Create Rubric Template
    {% endif %}
  </h2>
  <div class="divider"></div>

  <div class="card bg-base-100 shadow my-4">
    <div class="card-body">
    <form method="POST">
      {{ form.csrf_token }}
      {{ renderer.render_field(form.name) }}
      {{ renderer.render_field(form.curriculums) }}
      {{ renderer.render_field(form.class_type) }}
      {{ renderer.render_field(form.description) }}

      <button name="create" type="submit" class="btn btn-primary">
        {{ 'Save' if template else 'Create' }}
      </button>
    </form>
    </div>
  </div>

{% endblock %}
