{% extends '/base/default-dashboard.html.j2' %}

{% block dashboard_title %}
Admin
{% endblock %}

{% block breadcrumbs %}
    {{ super() }}
    <li>Admin</li>
{% endblock %}

{% block content %}

<h1 class="divider text-2xl font-bold">
	<i class="fa-solid fa-user-gear fa-sm"></i>
	Admin Dashboard
</h1>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
	{% for item in menu %}
	<a href="{{ url_for(item.endpoint) }}" class="card bg-base-100 shadow hover:shadow-lg transition-shadow border border-base-200">
		<div class="card-body">
			<div class="flex items-start justify-between gap-2">
				<div class="flex items-center gap-3">
					<i class="{{ item.icon }} fa-lg text-primary"></i>
					<h2 class="card-title text-base">{{ item.label }}</h2>
				</div>
				{% if item.count is not none %}
				<span class="badge badge-primary badge-lg">
					{{ item.count }}{% if item.count_label %} {{ item.count_label }}{% endif %}
				</span>
				{% endif %}
			</div>
			<p class="text-sm opacity-70">{{ item.description }}</p>
		</div>
	</a>
	{% endfor %}
</div>

{% endblock %}
