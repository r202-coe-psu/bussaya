{% extends '/admin/curriculums/view.html.j2' %}
{% import '/base/html-renderer.html.j2' as renderer %}

{% block dashboard_title %}
	{% if clo %}
		Edit
	{% else %}
		Create
	{% endif %}
	CLO
{% endblock %}

{% block breadcrumbs %}
  {{ super() }}
  {% if clo %}
    <li>Edit CLO</li>
  {% else %}
    <li>Create CLO</li>
  {% endif %}
{% endblock %}


{% block content %}
  <h2 class="text-2xl font-bold">
    {% if clo %}
      Edit CLO
    {% else %}
      Create CLO
    {% endif %}
    for {{ curriculum.name }}
  </h2>
  <div class="divider"></div>

  <div class="card bg-base-100 shadow my-4">
    <div class="card-body">
    <form method="POST">
      {{ form.csrf_token }}
      {{ renderer.render_field(form.code) }}
      {{ renderer.render_field(form.description) }}
      {{ renderer.render_field(form.description_th) }}
      {{ renderer.render_field(form.order) }}
      {{ renderer.render_field(form.plos) }}

      <button name="create" type="submit" class="btn btn-primary">
        {{ 'Edit' if clo else 'Create' }}
      </button>
    </form>
    </div>
  </div>

{% endblock %}
