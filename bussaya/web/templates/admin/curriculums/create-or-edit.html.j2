{% extends '/admin/curriculums/index.html.j2' %}
{% import '/base/html-renderer.html.j2' as renderer %}

{% block dashboard_title %}
	{% if curriculum %}
		Edit
	{% else %}
		Create
	{% endif %}
	Curriculum
{% endblock %}

{% block breadcrumbs %}
  {{ super() }}
	<li>
    {% if curriculum %}
      Edit
    {% else %}
      Create
    {% endif %}
    Curriculum
  </li>
{% endblock %}


{% block content %}
  <h2 class="text-2xl font-bold">
    {% if curriculum %}
      Edit Curriculum
    {% else %}
      Create Curriculum
    {% endif %}
  </h2>
  <div class="divider"></div>

  <div class="card bg-base-100 shadow my-4">
    <div class="card-body">
    <form method="POST">
      {{ form.csrf_token }}
      {{ renderer.render_field(form.name) }}
      {{ renderer.render_field(form.name_th) }}
      {{ renderer.render_field(form.code) }}

      <button name="create" type="submit" class="btn btn-primary">
        {{ 'Edit' if curriculum else 'Create' }}
      </button>
    </form>
    </div>
  </div>

{% endblock %}
