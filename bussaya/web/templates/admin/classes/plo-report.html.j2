{% extends '/admin/classes/index.html.j2' %}

{% block dashboard_title %}
PLO Achievement Report
{% endblock %}

{% block breadcrumbs %}
<li>
	<a href="{{ url_for('admin.classes.index') if current_user.has_roles('admin') else url_for('classes.index') }}">Classes</a>
</li>
<li>
	<a href="{{ url_for('admin.classes.view', class_id=class_.id) if current_user.has_roles('admin') else url_for('classes.view', class_id=class_.id) }}">{{ class_.name }}</a>
</li>
<li>PLO Achievement Report</li>
{% endblock %}

{% block content %}

<div class="divider text-xl font-bold">
	<i class="fa-solid fa-bullseye fa-sm"></i>
	PLO Achievement Report - {{ class_.name }}
</div>

<p class="text-sm opacity-70 mb-4">
	Each student's average achievement per PLO (scoped to their own curriculum) is counted as
	<span class="badge badge-success badge-sm gap-1"><i class="fa-solid fa-check"></i> Pass</span> at 60% or higher, otherwise
	<span class="badge badge-warning badge-sm gap-1"><i class="fa-solid fa-triangle-exclamation"></i> Improvement</span>.
</p>

<button type="button" id="toggle-identities-btn" onclick="toggleStudentIdentities()" class="btn btn-sm btn-outline mb-4">
	<i class="fa-solid fa-eye" id="toggle-identities-icon"></i>
	<span id="toggle-identities-label">Show Student Names</span>
</button>

{% if not rows %}
<div class="alert alert-info">No graded rubric data yet for this class.</div>
{% else %}
{% for row in rows %}
{% set total = row.pass_count + row.improvement_count %}
{% set pass_rate = (row.pass_count / total * 100) if total else 0 %}
<div class="card bg-base-100 shadow my-4">
	<div class="card-body p-4">
		<div class="flex flex-wrap items-start justify-between gap-2">
			<div>
				<h4 class="text-lg font-bold text-primary">{{ row.plo.code }}</h4>
				<div class="text-sm opacity-70">{{ row.plo.description }}</div>
			</div>
			<div class="text-right whitespace-nowrap">
				<div class="text-2xl font-bold {{ 'text-success' if pass_rate >= 60 else 'text-warning' }}">
					{{ '%.0f'|format(pass_rate) }}%
				</div>
				<div class="text-xs opacity-60">pass rate ({{ total }} student{{ 's' if total != 1 else '' }})</div>
			</div>
		</div>

		<progress class="progress {{ 'progress-success' if pass_rate >= 60 else 'progress-warning' }} w-full mt-2"
			value="{{ pass_rate }}" max="100"></progress>

		<div class="flex flex-wrap gap-2 mt-3">
			<span class="badge badge-success badge-lg gap-1"><i class="fa-solid fa-check"></i> Pass: {{ row.pass_count }}</span>
			<span class="badge badge-warning badge-lg gap-1"><i class="fa-solid fa-triangle-exclamation"></i> Improvement: {{ row.improvement_count }}</span>
		</div>

		<div class="divider my-2"></div>

		<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
			<div>
				<div class="font-semibold text-sm mb-2 text-success flex items-center gap-1">
					<i class="fa-solid fa-check-circle"></i> Pass (&ge; 60%)
				</div>
				{% if row.pass_students %}
				<div class="max-h-72 overflow-y-auto rounded-box border border-base-300">
					<table class="table table-zebra table-sm table-pin-rows">
						<thead>
							<tr>
								<th>Student</th>
								<th class="text-right">Score</th>
							</tr>
						</thead>
						<tbody>
							{% for s in row.pass_students %}
							<tr>
								<td>
									<span class="student-placeholder italic opacity-50">
										<span class="inline-flex items-center gap-1"><i class="fa-solid fa-user-secret"></i> Hidden</span>
									</span>
									<a class="student-identity hidden link link-hover font-medium" href="{{ url_for('accounts.profile', user_id=s.student.id) }}">{{ s.student.get_fullname() }}</a>
								</td>
								<td class="text-right">
									<span class="student-identity hidden badge badge-success badge-sm font-semibold">{{ '%.0f'|format(s.percentage) }}%</span>
								</td>
							</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
				{% else %}
				<div class="text-xs opacity-50 italic">No students</div>
				{% endif %}
			</div>
			<div>
				<div class="font-semibold text-sm mb-2 text-warning flex items-center gap-1">
					<i class="fa-solid fa-triangle-exclamation"></i> Improvement (&lt; 60%)
				</div>
				{% if row.improvement_students %}
				<div class="max-h-72 overflow-y-auto rounded-box border border-base-300">
					<table class="table table-zebra table-sm table-pin-rows">
						<thead>
							<tr>
								<th>Student</th>
								<th class="text-right">Score</th>
							</tr>
						</thead>
						<tbody>
							{% for s in row.improvement_students %}
							<tr>
								<td>
									<span class="student-placeholder italic opacity-50">
										<span class="inline-flex items-center gap-1"><i class="fa-solid fa-user-secret"></i> Hidden</span>
									</span>
									<a class="student-identity hidden link link-hover font-medium" href="{{ url_for('accounts.profile', user_id=s.student.id) }}">{{ s.student.get_fullname() }}</a>
								</td>
								<td class="text-right">
									<span class="student-identity hidden badge badge-warning badge-sm font-semibold">{{ '%.0f'|format(s.percentage) }}%</span>
								</td>
							</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
				{% else %}
				<div class="text-xs opacity-50 italic">No students</div>
				{% endif %}
			</div>
		</div>
	</div>
</div>
{% endfor %}
{% endif %}

{% endblock %}

{% block additional_js %}
<script>
	let studentIdentitiesRevealed = false;

	function toggleStudentIdentities() {
		studentIdentitiesRevealed = !studentIdentitiesRevealed;

		document.querySelectorAll('.student-identity').forEach(function (el) {
			el.classList.toggle('hidden', !studentIdentitiesRevealed);
		});
		document.querySelectorAll('.student-placeholder').forEach(function (el) {
			el.classList.toggle('hidden', studentIdentitiesRevealed);
		});

		var icon = document.getElementById('toggle-identities-icon');
		var label = document.getElementById('toggle-identities-label');
		icon.className = studentIdentitiesRevealed ? 'fa-solid fa-eye-slash' : 'fa-solid fa-eye';
		label.textContent = studentIdentitiesRevealed ? 'Hide Student Names' : 'Show Student Names';
	}
</script>
{% endblock additional_js %}
