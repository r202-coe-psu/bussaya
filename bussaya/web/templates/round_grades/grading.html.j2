{% extends '/admin/classes/index.html.j2' %}
{% import '/base/error-handler.html.j2' as eh %}
{% import '/admin/classes/project-renderer.html.j2' as renderer %}
{% import '/navbar/class-navbar.html.j2' as renderer_navbar %}

{% block breadcrumbs %}
<li><a href="{{ url_for('classes.index') }}">Classes</a></li>
<li><a href="{{ url_for('classes.view', class_id=class_.id) }}">{{ class_.name }}</a></li>
<li>
    <a href="{{ url_for('round_grades.view', class_id=class_.id, round_grade_type=round_grade.type) }}">
        {{ round_grade.get_type_display() }}
    </a>
</li>
<li>
    <a href="{{ url_for('round_grades.grading', round_grade_id=round_grade.id) }}">
        Grading
    </a>
</li>
{% endblock %}


{% block additional_head %}
{% include '/round_grades/shared/grading-style.html.j2' %}
{% endblock %}


{% block content %}

{{ renderer_navbar.render_class_navbar(class_, current_user) }}

<h2 class="text-2xl font-bold">
    Grading {{ round_grade.get_type_display() }} Grade</h2>
<div class="divider"></div>

<div class="">
    <div class="alert alert-info">
        <div class="space-y-1">
            <div><b>Started Date:</b> {{ round_grade.natural_started_date() }}</div>
            <div><b>Time Off Date:</b> {{ round_grade.natural_ended_date() }}</div>
            <div><b>Remaining Time:</b> {{ round_grade.remain_time()[1] }}</div>
            <div><b>Release Status:</b> {{ round_grade.get_release_status_display() }}</div>
        </div>
    </div>
</div>

{% include '/round_grades/shared/grading-body.html.j2' %}

{% endblock %}


{% block additional_js %}
{% include '/round_grades/shared/grading-js.html.j2' %}
{% endblock additional_js %}
